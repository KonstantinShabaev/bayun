# Сервис пользователя: ~/.config/systemd/user/bayun-tv-agent.service
# tv-agent (dev/tv): пульт ТВ и киоск Chromium; киоск он поднимает сам по требованию.
[Unit]
Description=Баюн: tv-agent (телевизор и киоск)
StartLimitIntervalSec=0

[Service]
WorkingDirectory=%h/bayun/tv
ExecStart=%h/.local/share/bayun/atv-venv/bin/python -m bayun_tv.agent
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
