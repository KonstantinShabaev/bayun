# Скопируйте в .env (chmod 600) и заполните. Файл .env в git не попадает.

# Где лежат данные и модели на сервере.
BAYUN_DATA=/srv/bayun

# Голос.
WHISPER_MODEL=small-int8
PIPER_VOICE=ru_RU-irina-medium

# Шлюз в облако (bayun-gateway). Ключи есть только здесь, у агентов их нет.
ANTHROPIC_API_KEY=
# Ключ, по которому brain ходит в шлюз. Любая длинная случайная строка: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-

# bayun-stt: dummy, пока не готов M1.
BAYUN_STT_ENGINE=dummy
